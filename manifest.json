{
  "manifest_version": 3,
  "name": "Conversor de Horas - Azure DevOps/ServiceNow",
  "version": "2.0.1",
  "description": "Converte horas e minutos e preenche o tempo no Azure DevOps (decimal) e no ServiceNow (HH:MM:SS).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Conversor de horas",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": [
        "*://dev.azure.com/*",
        "*://*.visualstudio.com/*"
      ],
      "js": ["content-script.js"]
    },
    {
      "matches": ["*://*.service-now.com/*"],
      "js": ["content-script-sn.js"],
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{7aad9c9c-26df-421f-a718-a8be44c81b17}",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
