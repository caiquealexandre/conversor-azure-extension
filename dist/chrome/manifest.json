{
  "manifest_version": 3,
  "name": "Conversor de Horas - Azure DevOps e ServiceNow",
  "version": "2.0.0",
  "description": "Converte horas e minutos e preenche o tempo no Azure DevOps (decimal) e no ServiceNow (HH:MM:SS).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Conversor de horas",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://dev.azure.com/*",
        "*://*.visualstudio.com/*"
      ],
      "js": [
        "content-script.js"
      ]
    },
    {
      "matches": [
        "*://*.service-now.com/*"
      ],
      "js": [
        "content-script-sn.js"
      ],
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
